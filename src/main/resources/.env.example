# Copier ce fichier en .env pour le developpement local
# Ne jamais committer .env
STRIPE_API_KEY=sk_test_replace_me

# SMTP (notifications par email) - compte Gmail + mot de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=exemple@gmail.com
SMTP_PASSWORD=mot_de_passe_application

# Si ce fichier .env existe, ces valeurs priment TOUJOURS sur le profil Maven
# actif (-Pdev/-Ppreprod/-Pprod) : supprimez/commentez-les pour laisser le
# profil Maven decider de la base utilisee (voir docs/DATABASE.md).
DB_URL=jdbc:h2:file:./kanban_db;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=

APP_ENV=dev
